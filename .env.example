# Copy to `.env` for local development: cp .env.example .env
# All values below are local placeholders. Never commit real credentials.

# development | test | demo | production
#   production: refuses to start with placeholder secrets and disables demo logins.
APP_ENV=development

# Local Postgres from docker-compose.dev.yml (port 54329).
DATABASE_URL=postgresql://cadence:cadence@localhost:54329/cadence

# Used to sign session tokens (HMAC-SHA256). At least 32 characters in production.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-for-local-dev

# Public URL of the app. Cookies are marked Secure when this is https.
APP_URL=http://localhost:3100
